<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:viewModels="clr-namespace:WpfApp1.Models"
        xmlns:wpfApp1="clr-namespace:WpfApp1"
        d:DataContext="{d:DesignInstance viewModels:MainWindowModel, IsDesignTimeCreatable=True}"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <wpfApp1:BoolToRowVisibilityConverter x:Key="BoolToRowVisibilityConverter" />
        <Style TargetType="{x:Type DataGridRow}" x:Key="DataGridRowStyle">
            <Setter Property="Visibility" 
                    Value="{Binding IsVisible, 
                          Converter={StaticResource BoolToRowVisibilityConverter}}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="{Binding CurrentRecord.RowIndex}" Margin="15,0" />
            <TextBox IsReadOnly="True" Text="{Binding CurrentRecord.Key, Mode=OneWay}" Margin="15,0" />
            <TextBox IsReadOnly="True" Text="{Binding CurrentRecord.Name, Mode=OneWay}" />
            <TextBlock Text="{Binding CurrentRecord.InvoiceAmount}" Margin="50, 0 ,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Content="Filter" Margin="15,0" Command="{Binding SearchCommand}"/>
            <TextBox MinWidth="100" Text="{Binding Filter}"/>
        </StackPanel>
        <DataGrid AutoGenerateColumns="False" Grid.Row="2" ItemsSource="{Binding Records}"
                  RowStyle="{StaticResource DataGridRowStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Key" Binding="{Binding Key, Mode=OneWay}" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="600" />
                <!-- 直接隐藏不需要显示的列 -->
                <DataGridTextColumn Header="InvoiceAmount" Binding="{Binding InvoiceAmount, Mode=OneWay}" />
                <DataGridTemplateColumn Header="IsChecked">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, 
                                  Mode=TwoWay, 
                                  UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="3" HorizontalAlignment="Left" Width="100" Command="{Binding NextCommand}"> Next </Button>
        <Button Grid.Row="3" HorizontalAlignment="Right" Width="100" Command="{Binding SaveCommand}"> Save </Button>
    </Grid>
</Window>